run = "python agents/main.py"
entrypoint = "agents/main.py"

[env]
PYTHONPATH = "${REPL_HOME}"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "streamlit run elo_calculator/dashboard/app.py --server.port 5000"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8501
externalPort = 8501

[languages]

[languages.python3]
pattern = "**/*.py"

[languages.python3.languageServer]
start = "pylsp"

[workflows]

[workflows.workflow]
name = "Run Agent System"
author = "replit"

[workflows.workflow.metadata]
agentRequiresPlan = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python agents/main.py"

[workflows.workflow-dashboard]
name = "Run Dashboard"
author = "replit"

[[workflows.workflow-dashboard.tasks]]
task = "shell.exec"
args = "streamlit run elo_calculator/dashboard/app.py"

[workflows.workflow-tests]
name = "Run Tests"
author = "replit"

[[workflows.workflow-tests.tasks]]
task = "shell.exec"
args = "python -m pytest elo_calculator/tests/ -v"

[workflows.workflow-check]
name = "Check Environment"
author = "replit"

[[workflows.workflow-check.tasks]]
task = "shell.exec"
args = "python agents/main.py --check"
